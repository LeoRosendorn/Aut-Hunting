# Copiar a .env.local y completar. Nunca commitear .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron: cualquier string aleatorio largo (Vercel lo manda como "Authorization: Bearer ...")
CRON_SECRET=

# Cupos (spec D1): 5 huntings y 10 lecturas con IA por usuaria por día.
# Se definen en la base: supabase/migrations/20261002010000_quota_enforcement.sql

# IA (capas gratuitas). Orden: Gemini Flash-Lite → Groq → Gemini Flash (lib/providers/ai.ts).
# GEMINI_API_KEY=
# Groq es opcional: suma un segundo proveedor con cupo propio. https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Búsqueda de perfiles: Exa primero, Tavily de respaldo.
# EXA_API_KEY=
# TAVILY_API_KEY=
# Tope mensual de Tavily (se reparte por día entre los días que quedan del mes).
# TAVILY_MONTHLY_CAP=950

# Email de contacto que muestran Privacidad, Términos y el pie de la web (opcional)
# NEXT_PUBLIC_CONTACT_EMAIL=
