# Copiar a .env.local y completar. Nunca commitear .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron: cualquier string aleatorio largo (Vercel lo manda como "Authorization: Bearer ...")
CRON_SECRET=

# Cupos (spec D1)
HUNTS_PER_USER_PER_DAY=5

# Issues siguientes (#3, #4): Gemini, Tavily, Serper
# GEMINI_API_KEY=
# GEMINI_MODEL=
# TAVILY_API_KEY=
# SERPER_API_KEY=
